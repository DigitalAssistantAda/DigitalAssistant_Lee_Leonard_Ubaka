# Backend Environment Variables
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database - Supabase PostgreSQL (required for cloud deployment)
# Get from: Supabase Dashboard → Settings → Database → Connection String
# Note: Use port 5432 (direct) not 6543 (transaction mode)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT Authentication - GENERATE A SECRET (see TEAM_SETUP.md)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-here-replace-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# File Storage - Separate from Database
# Options: "minio" (local), "s3" (AWS S3 or Cloudflare R2)
STORAGE_TYPE=s3
STORAGE_BUCKET=documents

# MinIO Settings (Local Development - not recommended for team sharing)
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Cloudflare R2 Settings (RECOMMENDED for team development)
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your_r2_access_key_here
S3_SECRET_KEY=your_r2_secret_key_here

# AWS S3 Settings (Alternative - use if not using R2)
# S3_ENDPOINT_URL=  # Leave empty for AWS S3
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Redis (for background jobs)
REDIS_URL=redis://redis:6379

# Embeddings (Voyage AI)
EMBEDDING_SERVICE=voyage
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-2

# Summary Generation (supports anthropic, openai, azure)
SUMMARY_LLM_ENABLED=true
SUMMARY_LLM_PROVIDER=anthropic
SUMMARY_LLM_API_URL=https://api.anthropic.com/v1/messages
SUMMARY_LLM_API_KEY=sk-ant-api03-your-key-here
SUMMARY_LLM_MODEL=claude-3-haiku-20240307
SUMMARY_LLM_TIMEOUT_SECONDS=45
SUMMARY_LLM_MAX_INPUT_CHARS=12000
SUMMARY_LLM_TEMPERATURE=0.2
SUMMARY_LLM_MAX_OUTPUT_TOKENS=500

# OpenAI alternative
# SUMMARY_LLM_PROVIDER=openai
# SUMMARY_LLM_API_URL=https://api.openai.com/v1/chat/completions
# SUMMARY_LLM_MODEL=gpt-4o-mini
# SUMMARY_LLM_API_KEY=sk-your-openai-key-here

# Azure OpenAI alternative
# SUMMARY_LLM_PROVIDER=azure
# SUMMARY_LLM_API_URL=https://YOUR_RESOURCE_NAME.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT_NAME/chat/completions?api-version=2024-02-15-preview
# SUMMARY_LLM_API_KEY=your_azure_openai_key_here
# SUMMARY_LLM_MODEL=  # Not required for azure deployment endpoint

# Environment
ENVIRONMENT=development
DEBUG=true

# OAuth (Optional - for future Phase 3 implementation)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

