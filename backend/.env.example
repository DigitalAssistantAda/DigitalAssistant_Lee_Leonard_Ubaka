# Backend Environment Variables
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database - Supabase PostgreSQL (required for cloud deployment)
# Get from: Supabase Dashboard → Settings → Database → Connection String
# Note: Use port 5432 (direct) not 6543 (transaction mode)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT Authentication - GENERATE A SECRET (see TEAM_SETUP.md)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-here-replace-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# File Storage - Separate from Database
STORAGE_TYPE=minio
STORAGE_BUCKET=documents

# MinIO Settings (Local Development)
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# S3 Settings (Production - leave empty for dev)
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Redis (for background jobs)
REDIS_URL=redis://redis:6379

# Environment
ENVIRONMENT=development
DEBUG=true

# OAuth (Optional - for future Phase 3 implementation)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

